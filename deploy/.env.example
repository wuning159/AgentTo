# 对外端口。服务器安全组应只向办公网或指定开发 IP 开放。
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
ELASTICSEARCH_BIND_ADDRESS=127.0.0.1
ELASTICSEARCH_PORT=9200
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TEI_BIND_ADDRESS=127.0.0.1
TEI_EMBEDDING_PORT=8081
TEI_RERANK_PORT=8082
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8080

# 正式数据目录和已有模型目录。
AGENTTO_DATA_DIR=/opt/agentto/data
MINIO_DATA_DIR=/opt/agentto/data/minio
MODEL_ROOT=/data/models

# MySQL
MYSQL_DATABASE=agentto
MYSQL_USER=agentto
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Redis、Elasticsearch、MinIO
REDIS_PASSWORD=replace-with-a-strong-password
ELASTIC_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=agentto-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# 模型 API
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 后端
AGENTTO_WORKFLOW_ADAPTER=memory
